# Wordhoard configuration template.
# Copy to .env (in the directory you run `wordhoard` from) and fill in values:
#   cp .env.dist .env
# Real environment variables take precedence over values in .env.
# Empty values fall back to the defaults noted below.
# Note: comments must be on their own line (inline "# ..." is not stripped).

# --- Translation provider ---------------------------------------------------
# Which online translator to use: gemini | openai | deepl  (default: gemini)
WORDHOARD_TRANSLATOR=gemini

# --- Gemini (used when WORDHOARD_TRANSLATOR=gemini) -------------------------
# API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Model name (default: gemini-3.5-flash-lite)
WORDHOARD_GEMINI_MODEL=

# --- OpenAI (used when WORDHOARD_TRANSLATOR=openai) -------------------------
OPENAI_API_KEY=
# Model name (default: gpt-4o-mini)
WORDHOARD_OPENAI_MODEL=

# --- DeepL (used when WORDHOARD_TRANSLATOR=deepl) ---------------------------
# Free-tier keys end in ":fx" and automatically use api-free.deepl.com
DEEPL_API_KEY=

# --- Advanced: API base URL overrides (mainly for testing / proxies) --------
# Defaults: https://generativelanguage.googleapis.com, https://api.openai.com,
# and https://api.deepl.com or https://api-free.deepl.com depending on the key.
WORDHOARD_GEMINI_BASE_URL=
WORDHOARD_OPENAI_BASE_URL=
WORDHOARD_DEEPL_BASE_URL=
